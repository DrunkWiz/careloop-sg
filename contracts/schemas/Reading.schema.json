{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "Reading.schema.json",
  "title": "Reading",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "senior_id": {
      "type": "string"
    },
    "time": {
      "type": "string",
      "format": "date-time"
    },
    "kind": {
      "type": "string",
      "enum": [
        "bp",
        "hr",
        "steps",
        "sleep",
        "glucose"
      ]
    },
    "values": {
      "type": "object",
      "description": "bp: systolic, diastolic, pulse?; hr: bpm; steps: count; sleep: hours; glucose: value + unit",
      "additionalProperties": {
        "type": [
          "number",
          "string",
          "null"
        ]
      }
    },
    "source": {
      "type": "string",
      "enum": [
        "cuff",
        "watch",
        "voice",
        "synthetic"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "trust": {
      "type": "object",
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "flags": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "impossible",
              "swapped",
              "units",
              "no_reading",
              "duplicate"
            ]
          }
        }
      },
      "required": [
        "ok",
        "flags"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "senior_id",
    "time",
    "kind",
    "values",
    "source",
    "confidence",
    "trust"
  ],
  "additionalProperties": false
}
